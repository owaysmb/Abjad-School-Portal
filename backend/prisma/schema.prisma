generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())

  teacher Teacher?
  student Student?
  parent  Parent?
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
  PARENT
}

model Teacher {
  id         String         @id @default(uuid())
  user       User           @relation(fields: [userId], references: [id])
  userId     String         @unique
  classes    ClassTeacher[]
  attendance Attendance[]
  Feedback   Feedback[]
  Mood       Mood[]
}

model Student {
  id         String          @id @default(uuid())
  level      String
  user       User            @relation(fields: [userId], references: [id])
  userId     String          @unique
  classId    String
  class      Class           @relation(fields: [classId], references: [id])
  parents    ParentStudent[]
  attendance Attendance[]
  grades     Grade[]
  Feedback   Feedback[]
  Mood       Mood[]
}

model Parent {
  id       String          @id @default(uuid())
  user     User            @relation(fields: [userId], references: [id])
  userId   String          @unique
  children ParentStudent[]
}

model ParentStudent {
  parent    Parent  @relation(fields: [parentId], references: [id])
  parentId  String
  student   Student @relation(fields: [studentId], references: [id])
  studentId String

  @@id([parentId, studentId])
}

model Class {
  id         String         @id @default(uuid())
  name       String
  level      String
  students   Student[]
  teachers   ClassTeacher[]
  attendance Attendance[]
  grades     Grade[]
}

model ClassTeacher {
  class     Class   @relation(fields: [classId], references: [id])
  classId   String
  teacher   Teacher @relation(fields: [teacherId], references: [id])
  teacherId String
  subject   String

  @@id([classId, teacherId, subject])
}

model Attendance {
  id        String   @id @default(uuid())
  date      DateTime
  present   Boolean
  student   Student  @relation(fields: [studentId], references: [id])
  studentId String
  class     Class    @relation(fields: [classId], references: [id])
  classId   String
  teacher   Teacher  @relation(fields: [teacherId], references: [id])
  teacherId String
}

model Grade {
  id        String   @id @default(uuid())
  subject   String
  score     Float
  maxScore  Float
  term      String
  student   Student  @relation(fields: [studentId], references: [id])
  studentId String
  class     Class    @relation(fields: [classId], references: [id])
  classId   String
  createdAt DateTime @default(now())
}

model Announcement {
  id        String   @id @default(uuid())
  title     String
  body      String
  createdAt DateTime @default(now())
  authorId  String
}

model Feedback {
  id        String   @id @default(uuid())
  note      String
  date      DateTime @default(now())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id])
}

model Mood {
  id        String   @id @default(uuid())
  mood      String // focused, tired, anxious, hyperactive, happy
  date      DateTime @default(now())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id])
}
